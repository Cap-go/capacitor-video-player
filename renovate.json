{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "matchFileNames": [
        "android/**",
        "example-app/android/**"
      ],
      "allowedVersions": "<9.6.0"
    }
  ]
}
